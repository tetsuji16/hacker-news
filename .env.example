# Hacker News Podcast - Environment Variables Example
# Copy this file to .env and fill in the values

# Google AI Studio API Key (for Gemini models)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (fallback for summarization)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Schedule time (HH:MM) - default is 08:00
SCHEDULE_TIME=06:00

# Base URL for the podcast files (RSS and MP3)
# Example: https://your-username.github.io/hacker-news/
PODCAST_BASE_URL=https://your-domain.com/hacker-news/

# Enable pushing to GitHub (requires Git configured and PAT)
ENABLE_GIT_PUSH=false

# Git Configuration (if ENABLE_GIT_PUSH is true)
GIT_USER_NAME=your_name
GIT_USER_EMAIL=your_email@example.com
# GH_PAT=your_github_personal_access_token (Can also be set in docker-compose.yml)
